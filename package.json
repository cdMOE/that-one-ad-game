{
  "name": "that-one-ad-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "description": "That One Ad Game: the squad shooter from the ads, for real. Open source, in the browser, no ads.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "typecheck": "tsc --noEmit",
    "simulate:campaign": "tsx scripts/simulate-campaign.ts",
    "compare:runlog": "tsx scripts/compare-runlog.ts",
    "build:shooter-levels": "tsx scripts/build-shooter-levels.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
